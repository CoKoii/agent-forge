{
  "name": "agent-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test run --dir packages/utils && pnpm --filter @vben/admin run test && vp test run --root packages/vben --config ../../apps/admin/vitest.config.ts",
    "build": "pnpm --filter @vben/admin run build",
    "ready": "pnpm run check && pnpm run test && pnpm run build",
    "dev": "pnpm --parallel --filter website --filter backend --filter @vben/admin run dev"
  },
  "devDependencies": {
    "@vben/tsconfig": "workspace:*",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
