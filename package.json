{
  "name": "agent-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test run",
    "build": "pnpm --recursive --if-present run build",
    "ready": "pnpm run check && pnpm run test && pnpm run build",
    "dev": "vp run --parallel --filter website --filter backend dev"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
