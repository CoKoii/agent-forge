# =========================基础配置=========================
# 环境
NODE_ENV=development

# 日志等级
LOG_LEVEL=debug

# 跨域配置
CORS_ORIGIN=*

# PostgreSQL 应用连接配置（本机 deploy PostgreSQL）
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=agent_forge
DB_PASSWORD=replace-with-local-password
DB_DATABASE=agent_forge
DB_POOL_MAX=10
# =========================基础配置=========================
