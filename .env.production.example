# =========================基础配置=========================
# 环境
NODE_ENV=production

# 日志等级
LOG_LEVEL=info

# 跨域配置
CORS_ORIGIN=https://your-frontend.example

# =========================数据库配置=========================
# 由生产部署环境提供实际连接信息
DB_HOST=your-production-postgres-host
DB_PORT=5432
DB_USERNAME=your-production-db-user
DB_PASSWORD=
DB_DATABASE=agent_forge
DB_POOL_MAX=10
# =========================数据库配置=========================
# =========================基础配置=========================
